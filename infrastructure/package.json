{
  "name": "@vaidyalink/infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for VaidyaLink",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "cdk": "cdk",
    "deploy:dev": "cdk deploy --context env=dev --all",
    "deploy:staging": "cdk deploy --context env=staging --all",
    "deploy:prod": "cdk deploy --context env=prod --all --require-approval never",
    "deploy:minimal": "cdk deploy --app \"npx ts-node bin/minimal-stack.ts\" --context env=dev --require-approval never --output cdk.out.minimal",
    "synth": "cdk synth",
    "diff": "cdk diff"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "aws-cdk": "^2.110.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.18.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.110.0",
    "constructs": "^10.3.0",
    "dotenv": "^16.3.1",
    "source-map-support": "^0.5.21"
  }
}
