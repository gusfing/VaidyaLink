# =============================================================================
# VaidyaLink Infrastructure Environment Configuration
# =============================================================================
# This file contains environment variables for AWS CDK infrastructure deployment.
# Copy this file to .env and fill in the actual values before deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Account Configuration
# -----------------------------------------------------------------------------
#

STACK_PREFIX=vaidyalink

# Enable resource tagging
ENABLE_RESOURCE_TAGGING=true

# Cost center tag for billing
COST_CENTER=healthcare-platform

# Project tag
PROJECT=vaidyalink

# -----------------------------------------------------------------------------
# Domain and DNS Configuration
# -----------------------------------------------------------------------------
# Primary domain name
DOMAIN_NAME=vaidyalink.com

# API subdomain
API_SUBDOMAIN=api

# WebSocket subdomain
WS_SUBDOMAIN=ws

# Route53 Hosted Zone ID
ROUTE53_HOSTED_ZONE_ID=

# Enable custom domain for API Gateway
ENABLE_CUSTOM_DOMAIN=true

# ACM Certificate ARN for HTTPS
ACM_CERTIFICATE_ARN=

# -----------------------------------------------------------------------------
# Cognito Configuration
# -----------------------------------------------------------------------------
# Enable Cognito User Pool creation
ENABLE_COGNITO=true

# Cognito User Pool name
COGNITO_USER_POOL_NAME=vaidyalink-users

# Enable MFA for Cognito
ENABLE_MFA=true

# MFA type (SMS, TOTP, OPTIONAL)
MFA_TYPE=OPTIONAL

# Password policy minimum length
PASSWORD_MIN_LENGTH=12

# Enable email verification
ENABLE_EMAIL_VERIFICATION=true

# Enable phone verification
ENABLE_PHONE_VERIFICATION=true

# Cognito domain prefix
COGNITO_DOMAIN_PREFIX=vaidyalink-auth

# -----------------------------------------------------------------------------
# S3 Bucket Configuration
# -----------------------------------------------------------------------------
# Enable S3 bucket creation
ENABLE_S3_BUCKETS=true

# S3 bucket name for documents
S3_DOCUMENTS_BUCKET_NAME=vaidyalink-documents-prod

# S3 bucket name for audio files
S3_AUDIO_BUCKET_NAME=vaidyalink-audio-prod

# S3 bucket name for processed data
S3_PROCESSED_BUCKET_NAME=vaidyalink-processed-prod

# S3 bucket name for FHIR exports
S3_FHIR_EXPORTS_BUCKET_NAME=vaidyalink-fhir-exports-prod

# Enable S3 versioning
ENABLE_S3_VERSIONING=true

# Enable S3 encryption
ENABLE_S3_ENCRYPTION=true

# S3 lifecycle policy - transition to IA after days
S3_TRANSITION_TO_IA_DAYS=90

# S3 lifecycle policy - transition to Glacier after days
S3_TRANSITION_TO_GLACIER_DAYS=365

# S3 lifecycle policy - expiration after days (0 = never)
S3_EXPIRATION_DAYS=2555

# -----------------------------------------------------------------------------
# DynamoDB Configuration
# -----------------------------------------------------------------------------
# Enable DynamoDB table creation
ENABLE_DYNAMODB=true

# DynamoDB billing mode (PAY_PER_REQUEST, PROVISIONED)
DYNAMODB_BILLING_MODE=PAY_PER_REQUEST

# Enable point-in-time recovery
ENABLE_PITR=true

# Enable DynamoDB encryption
ENABLE_DYNAMODB_ENCRYPTION=true

# DynamoDB table names
DYNAMODB_SCAN_JOBS_TABLE=vaidyalink-scan-jobs-prod
DYNAMODB_PATIENTS_TABLE=vaidyalink-patients-prod
DYNAMODB_VOICE_JOBS_TABLE=vaidyalink-voice-jobs-prod
DYNAMODB_HITL_TASKS_TABLE=vaidyalink-hitl-tasks-prod
DYNAMODB_CONSENT_TABLE=vaidyalink-consent-artifacts-prod
DYNAMODB_CONNECTIONS_TABLE=vaidyalink-ws-connections-prod

# -----------------------------------------------------------------------------
# Lambda Configuration
# -----------------------------------------------------------------------------
# Lambda runtime for Node.js functions
LAMBDA_NODEJS_RUNTIME=nodejs18.x

# Lambda runtime for Python functions
LAMBDA_PYTHON_RUNTIME=python3.11

# Lambda memory size (MB)
LAMBDA_MEMORY_SIZE=1024

# Lambda timeout (seconds)
LAMBDA_TIMEOUT=30

# Lambda reserved concurrent executions (0 = unreserved)
LAMBDA_RESERVED_CONCURRENCY=0

# Enable Lambda X-Ray tracing
ENABLE_LAMBDA_XRAY=true

# Enable Lambda insights
ENABLE_LAMBDA_INSIGHTS=true

# Lambda log retention (days)
LAMBDA_LOG_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# API Gateway Configuration
# -----------------------------------------------------------------------------
# Enable API Gateway creation
ENABLE_API_GATEWAY=true

# API Gateway type (REST, HTTP)
API_GATEWAY_TYPE=REST

# Enable API Gateway logging
ENABLE_API_LOGGING=true

# API Gateway log level (INFO, ERROR)
API_LOG_LEVEL=INFO

# Enable API Gateway metrics
ENABLE_API_METRICS=true

# Enable API Gateway X-Ray tracing
ENABLE_API_XRAY=true

# API Gateway throttle rate limit (requests per second)
API_THROTTLE_RATE_LIMIT=1000

# API Gateway throttle burst limit
API_THROTTLE_BURST_LIMIT=2000

# Enable WebSocket API
ENABLE_WEBSOCKET_API=true

# -----------------------------------------------------------------------------
# AWS HealthLake Configuration
# -----------------------------------------------------------------------------
# Enable HealthLake datastore creation
ENABLE_HEALTHLAKE=true

# HealthLake datastore name
HEALTHLAKE_DATASTORE_NAME=vaidyalink-fhir-datastore

# HealthLake FHIR version (R4)
HEALTHLAKE_FHIR_VERSION=R4

# HealthLake preload data type (SYNTHEA, NONE)
HEALTHLAKE_PRELOAD_DATA=NONE

# -----------------------------------------------------------------------------
# Amazon Bedrock Configuration
# -----------------------------------------------------------------------------
# Bedrock model ID for document processing
BEDROCK_DOCUMENT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock model ID for clinical summarization
BEDROCK_SUMMARY_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock region
BEDROCK_REGION=us-east-1

# Enable Bedrock model access
ENABLE_BEDROCK_ACCESS=true

# -----------------------------------------------------------------------------
# SQS Configuration
# -----------------------------------------------------------------------------
# Enable SQS queue creation
ENABLE_SQS=true

# HITL queue name
SQS_HITL_QUEUE_NAME=vaidyalink-hitl-queue-prod

# HITL DLQ name
SQS_HITL_DLQ_NAME=vaidyalink-hitl-dlq-prod

# Message retention period (seconds)
SQS_MESSAGE_RETENTION=1209600

# Visibility timeout (seconds)
SQS_VISIBILITY_TIMEOUT=900

# Enable SQS encryption
ENABLE_SQS_ENCRYPTION=true

# -----------------------------------------------------------------------------
# KMS Configuration
# -----------------------------------------------------------------------------
# Enable KMS key creation
ENABLE_KMS=true

# KMS key alias
KMS_KEY_ALIAS=alias/vaidyalink-prod

# Enable automatic key rotation
ENABLE_KEY_ROTATION=true

# Key deletion window (days)
KEY_DELETION_WINDOW_DAYS=30

# -----------------------------------------------------------------------------
# CloudWatch Configuration
# -----------------------------------------------------------------------------
# Enable CloudWatch alarms
ENABLE_CLOUDWATCH_ALARMS=true

# Error rate alarm threshold (percentage)
ERROR_RATE_THRESHOLD=5

# Latency alarm threshold (milliseconds)
LATENCY_THRESHOLD=3000

# Enable CloudWatch dashboards
ENABLE_DASHBOARDS=true

# CloudWatch log retention (days)
LOG_RETENTION_DAYS=30

# Enable CloudWatch Insights
ENABLE_INSIGHTS=true

# -----------------------------------------------------------------------------
# SNS Configuration
# -----------------------------------------------------------------------------
# Enable SNS topic creation
ENABLE_SNS=true

# SNS topic name for notifications
SNS_NOTIFICATION_TOPIC_NAME=vaidyalink-notifications-prod

# SNS topic name for alarms
SNS_ALARM_TOPIC_NAME=vaidyalink-alarms-prod

# Alarm notification email
ALARM_EMAIL=

# Enable SMS notifications
ENABLE_SMS_NOTIFICATIONS=false

# -----------------------------------------------------------------------------
# VPC Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable VPC creation for Lambda functions
ENABLE_VPC=false

# VPC CIDR block
# VPC_CIDR=10.0.0.0/16

# Number of availability zones
# VPC_AZ_COUNT=2

# Enable NAT Gateway
# ENABLE_NAT_GATEWAY=true

# -----------------------------------------------------------------------------
# WAF Configuration
# -----------------------------------------------------------------------------
# Enable WAF for API Gateway
ENABLE_WAF=true

# WAF rate limit (requests per 5 minutes)
WAF_RATE_LIMIT=2000

# Enable WAF managed rules
ENABLE_WAF_MANAGED_RULES=true

# Enable geo blocking
ENABLE_GEO_BLOCKING=false

# Blocked countries (comma-separated ISO codes)
# BLOCKED_COUNTRIES=

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# Enable AWS Backup
ENABLE_AWS_BACKUP=true

# Backup retention period (days)
BACKUP_RETENTION_DAYS=35

# Backup schedule (cron expression)
BACKUP_SCHEDULE=cron(0 2 * * ? *)

# Enable cross-region backup
ENABLE_CROSS_REGION_BACKUP=false

# Backup destination region
# BACKUP_DESTINATION_REGION=ap-south-2

# -----------------------------------------------------------------------------
# Cost Optimization Configuration
# -----------------------------------------------------------------------------
# Enable S3 Intelligent-Tiering
ENABLE_S3_INTELLIGENT_TIERING=true

# Enable DynamoDB auto-scaling (if PROVISIONED mode)
ENABLE_DYNAMODB_AUTOSCALING=false

# Enable Lambda reserved concurrency limits
ENABLE_LAMBDA_CONCURRENCY_LIMITS=false

# Enable CloudWatch log data retention policies
ENABLE_LOG_RETENTION_POLICIES=true

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Enable encryption at rest for all services
ENABLE_ENCRYPTION_AT_REST=true

# Enable encryption in transit (TLS 1.3)
ENABLE_ENCRYPTION_IN_TRANSIT=true

# Enable CloudTrail logging
ENABLE_CLOUDTRAIL=true

# CloudTrail S3 bucket name
CLOUDTRAIL_BUCKET_NAME=vaidyalink-cloudtrail-prod

# Enable GuardDuty
ENABLE_GUARDDUTY=true

# Enable Security Hub
ENABLE_SECURITY_HUB=true

# Enable AWS Config
ENABLE_AWS_CONFIG=true

# -----------------------------------------------------------------------------
# Compliance Configuration
# -----------------------------------------------------------------------------
# Enable HIPAA compliance features
ENABLE_HIPAA_COMPLIANCE=true

# Enable audit logging
ENABLE_AUDIT_LOGGING=true

# Audit log retention (days)
AUDIT_LOG_RETENTION_DAYS=2555

# Enable data residency controls
ENABLE_DATA_RESIDENCY=true

# -----------------------------------------------------------------------------
# Deployment Configuration
# -----------------------------------------------------------------------------
# Enable CDK asset staging
ENABLE_ASSET_STAGING=true

# CDK bootstrap version
CDK_BOOTSTRAP_VERSION=14

# Enable stack termination protection
ENABLE_TERMINATION_PROTECTION=true

# Enable automatic rollback on failure
ENABLE_AUTO_ROLLBACK=true

# Deployment notification email
DEPLOYMENT_EMAIL=

# -----------------------------------------------------------------------------
# External Service Configuration
# -----------------------------------------------------------------------------
# Bhashini API key (for voice processing)
BHASHINI_API_KEY=

# Bhashini user ID
BHASHINI_USER_ID=

# ABDM Client ID
ABDM_CLIENT_ID=

# ABDM Client Secret
ABDM_CLIENT_SECRET=

# ABDM Gateway URL
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway

# ABDM Sandbox mode
ABDM_SANDBOX_MODE=true
