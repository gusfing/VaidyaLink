# =============================================================================
# ABDM Connector Lambda Environment Configuration
# =============================================================================
# This Lambda handles integration with Ayushman Bharat Digital Mission (ABDM)
# including ABHA authentication, Health Information Exchange, and consent management.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# AWS Region
AWS_REGION=ap-south-1

# AWS Account ID
AWS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# ABDM API Configuration
# -----------------------------------------------------------------------------
# ABDM Gateway base URL
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway

# ABDM Client ID
ABDM_CLIENT_ID=

# ABDM Client Secret
ABDM_CLIENT_SECRET=

# ABDM API version
ABDM_API_VERSION=v3

# ABDM request timeout (in seconds)
ABDM_TIMEOUT=30

# Maximum retries for ABDM API calls
ABDM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# ABHA (Ayushman Bharat Health Account) Configuration
# -----------------------------------------------------------------------------
# ABHA authentication endpoint
ABHA_AUTH_URL=https://abhasbx.abdm.gov.in/abha/api/v3

# ABHA number verification endpoint
ABHA_VERIFY_URL=https://abhasbx.abdm.gov.in/abha/api/v3/profile

# Enable ABHA mobile OTP authentication
ENABLE_MOBILE_OTP_AUTH=true

# Enable ABHA Aadhaar OTP authentication
ENABLE_AADHAAR_OTP_AUTH=true

# OTP validity duration (in seconds)
OTP_VALIDITY_SECONDS=300

# Maximum OTP retry attempts
MAX_OTP_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Health Information Exchange (HIE) Configuration
# -----------------------------------------------------------------------------
# HIE Gateway URL
HIE_GATEWAY_URL=https://dev.abdm.go
Consent Manager URL
CONSENT_MANAGER_URL=https://dev.abdm.gov.in/consent

# Default consent validity period (in days)
DEFAULT_CONSENT_VALIDITY_DAYS=365

# Enable automatic consent renewal
ENABLE_AUTO_CONSENT_RENEWAL=false

# Consent revocation grace period (in seconds)
CONSENT_REVOCATION_GRACE_PERIOD=5

# Supported consent purposes (comma-separated)
CONSENT_PURPOSES=CAREMGT,BTG,PUBHLTH,HPAYMT,DSRCH,PATRQT

# Supported health information types (comma-separated)
HEALTH_INFO_TYPES=Prescription,DiagnosticReport,OPConsultation,DischargeSummary,ImmunizationRecord,HealthDocumentRecord,WellnessRecord

# -----------------------------------------------------------------------------
# Health Facility Registry Configuration
# -----------------------------------------------------------------------------
# Health Facility Registry URL
HFR_URL=https://facilitysbx.abdm.gov.in/api

# Enable facility verification
ENABLE_FACILITY_VERIFICATION=true

# Facility verification cache TTL (in seconds)
FACILITY_CACHE_TTL=86400

# -----------------------------------------------------------------------------
# DynamoDB Configuration
# -----------------------------------------------------------------------------
# DynamoDB table for ABDM sessions
DYNAMODB_ABDM_SESSIONS_TABLE=vaidyalink-abdm-sessions-prod

# DynamoDB table for consent artifacts
DYNAMODB_CONSENT_TABLE=vaidyalink-consent-artifacts-prod

# DynamoDB table for HIE transactions
DYNAMODB_HIE_TRANSACTIONS_TABLE=vaidyalink-hie-transactions-prod

# DynamoDB table for patient ABHA mappings
DYNAMODB_PATIENTS_TABLE=vaidyalink-patients-prod

# -----------------------------------------------------------------------------
# AWS HealthLake Configuration
# -----------------------------------------------------------------------------
# HealthLake datastore ID
HEALTHLAKE_DATASTORE_ID=

# HealthLake endpoint
HEALTHLAKE_ENDPOINT=https://healthlake.ap-south-1.amazonaws.com

# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------
# Webhook endpoint for ABDM callbacks
WEBHOOK_BASE_URL=https://api.vaidyalink.com/v1/abdm/webhook

# Enable webhook signature verification
ENABLE_WEBHOOK_VERIFICATION=true

# Webhook secret for signature verification
WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Data Transformation Configuration
# -----------------------------------------------------------------------------
# Enable FHIR to ABDM format conversion
ENABLE_FHIR_TO_ABDM_CONVERSION=true

# Enable ABDM to FHIR format conversion
ENABLE_ABDM_TO_FHIR_CONVERSION=true

# FHIR Transformer Lambda ARN
FHIR_TRANSFORMER_LAMBDA_ARN=arn:aws:lambda:ap-south-1:ACCOUNT_ID:function:vaidyalink-fhir-transformer-prod

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Enable request signing for ABDM APIs
ENABLE_REQUEST_SIGNING=true

# Enable response verification
ENABLE_RESPONSE_VERIFICATION=true

# KMS key ID for encrypting ABDM credentials
KMS_KEY_ID=

# Enable encryption for consent artifacts
ENABLE_CONSENT_ENCRYPTION=true

# Enable encryption for HIE data
ENABLE_HIE_ENCRYPTION=true

# -----------------------------------------------------------------------------
# Compliance Configuration
# -----------------------------------------------------------------------------
# Enable audit logging for all ABDM operations
ENABLE_AUDIT_LOGGING=true

# Audit log retention period (in days)
AUDIT_LOG_RETENTION_DAYS=2555

# Enable consent verification before data sharing
ENFORCE_CONSENT_VERIFICATION=true

# Enable data access logging
ENABLE_ACCESS_LOGGING=true

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Maximum ABDM API requests per minute
MAX_REQUESTS_PER_MINUTE=100

# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Rate limit burst capacity
RATE_LIMIT_BURST=20

# -----------------------------------------------------------------------------
# Monitoring and Logging
# -----------------------------------------------------------------------------
# CloudWatch log group
LOG_GROUP=/aws/lambda/vaidyalink-abdm-connector-prod

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable X-Ray tracing
ENABLE_XRAY_TRACING=true

# Enable detailed metrics
ENABLE_DETAILED_METRICS=true

# Enable ABDM operation metrics
ENABLE_ABDM_METRICS=true

# -----------------------------------------------------------------------------
# Development Configuration
# -----------------------------------------------------------------------------
# Use ABDM sandbox environment
USE_SANDBOX=true

# Enable mock ABDM responses for testing
ENABLE_MOCK_RESPONSES=false
