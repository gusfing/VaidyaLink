# =============================================================================
# FHIR Transformer Lambda Environment Configuration
# =============================================================================
# This Lambda converts structured clinical data to HL7 FHIR R4 resources and
# stores them in AWS HealthLake with international code system mapping.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# AWS Region
AWS_REGION=ap-south-1

# AWS Account ID
AWS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# AWS HealthLake Configuration
# -----------------------------------------------------------------------------
# HealthLake datastore ID
HEALTHLAKE_DATASTORE_ID=

# HealthLake datastore endpoint
HEALTHLAKE_ENDPOINT=https://healthlake.ap-south-1.amazonaws.com

# HealthLake API version
HEALTHLAKE_API_VERSION=R4

# Enable batch operations for multiple resources
ENABLE_BATCH_OPERATIONS=true

# Maximum batch size for FHIR bundle uploads
MAX_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# DynamoDB Configuration
# -----------------------------------------------------------------------------
# DynamoDB table for scan jobs
DYNAMODB_SCAN_JOBS_TABLE=vaidyalink-scan-jobs-prod

# DynamoDB table for patient records
DYNAMODB_PATIENTS_TABLE=vaidyalink-patients-prod

# DynamoDB table for FHIR resource mappings
DYNAMODB_FHIR_MAPPINGS_TABLE=vaidyalink-fhir-mappings-prod

# -----------------------------------------------------------------------------
# S3 Configuration
# -----------------------------------------------------------------------------
# S3 bucket for FHIR exports
S3_FHIR_EXPORTS_BUCKET=vaidyalink-fhir-exports-prod

# S3 key prefix for exports
S3_EXPORTS_PREFIX=exports/

# Enable versioning for FHIR exports
ENABLE_EXPORT_VERSIONING=true

# -----------------------------------------------------------------------------
# FHIR Configuration
# -----------------------------------------------------------------------------
# FHIR version (R4, R5)
FHIR_VERSION=R4

# FHIR profile validation (strict, lenient, none)
FHIR_VALIDATION_MODE=strict

# Enable FHIR resource valid
APPING=true

# Lab tests to LOINC codes
ENABLE_LAB_MAPPING=true

# Procedures to SNOMED CT
ENABLE_PROCEDURE_MAPPING=true

# Code system mapping service endpoint (optional)
# CODE_MAPPING_SERVICE_URL=https://terminology.vaidyalink.com

# Fallback to original codes if mapping fails
FALLBACK_TO_ORIGINAL_CODES=true

# -----------------------------------------------------------------------------
# FHIR Resource Configuration
# -----------------------------------------------------------------------------
# Default organization identifier for resources
ORGANIZATION_IDENTIFIER=https://vaidyalink.com

# Default practitioner system
PRACTITIONER_SYSTEM=https://vaidyalink.com/practitioners

# Default patient identifier system
PATIENT_IDENTIFIER_SYSTEM=https://vaidyalink.com/patients

# ABHA identifier system
ABHA_IDENTIFIER_SYSTEM=https://abdm.gov.in/abha

# Enable automatic patient matching
ENABLE_PATIENT_MATCHING=true

# Patient matching threshold (0.0 - 1.0)
PATIENT_MATCH_THRESHOLD=0.90

# -----------------------------------------------------------------------------
# Data Quality Configuration
# -----------------------------------------------------------------------------
# Enable data quality checks
ENABLE_QUALITY_CHECKS=true

# Minimum required fields for Patient resource (comma-separated)
PATIENT_REQUIRED_FIELDS=name,gender,birthDate

# Minimum required fields for MedicationStatement (comma-separated)
MEDICATION_REQUIRED_FIELDS=medication,subject,status

# Enable date validation
ENABLE_DATE_VALIDATION=true

# Enable dosage validation
ENABLE_DOSAGE_VALIDATION=true

# Enable drug name validation against formularies
ENABLE_DRUG_VALIDATION=true

# Drug formulary reference (Indian Pharmacopoeia, WHO Essential Medicines)
DRUG_FORMULARY=indian_pharmacopoeia,who_essential

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------
# Maximum processing time in seconds
MAX_PROCESSING_TIME=10

# Enable parallel resource creation
ENABLE_PARALLEL_CREATION=true

# Maximum concurrent HealthLake operations
MAX_CONCURRENT_OPERATIONS=10

# Enable resource caching
ENABLE_RESOURCE_CACHE=true

# Cache TTL in seconds
CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Export Configuration
# -----------------------------------------------------------------------------
# Default export format (json, xml, both)
DEFAULT_EXPORT_FORMAT=json

# Enable pretty-printing for JSON exports
ENABLE_PRETTY_PRINT=true

# Include narrative text in resources
INCLUDE_NARRATIVE=true

# Include contained resources
INCLUDE_CONTAINED_RESOURCES=false

# -----------------------------------------------------------------------------
# Integration Configuration
# -----------------------------------------------------------------------------
# Enable ABDM integration
ENABLE_ABDM_INTEGRATION=true

# ABDM Connector Lambda ARN
ABDM_CONNECTOR_LAMBDA_ARN=arn:aws:lambda:ap-south-1:ACCOUNT_ID:function:vaidyalink-abdm-connector-prod

# Enable automatic push to ABDM
ENABLE_AUTO_ABDM_PUSH=false

# -----------------------------------------------------------------------------
# Monitoring and Logging
# -----------------------------------------------------------------------------
# CloudWatch log group
LOG_GROUP=/aws/lambda/vaidyalink-fhir-transformer-prod

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable X-Ray tracing
ENABLE_XRAY_TRACING=true

# Enable detailed metrics
ENABLE_DETAILED_METRICS=true

# Enable FHIR operation metrics
ENABLE_FHIR_METRICS=true

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# KMS key ID for encrypting FHIR exports
KMS_KEY_ID=

# Enable encryption for exports at rest
ENABLE_ENCRYPTION=true
