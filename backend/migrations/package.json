{
  "name": "@vaidyalink/migrations",
  "version": "1.0.0",
  "description": "DynamoDB migration framework for VaidyaLink",
  "main": "framework/migration-manager.js",
  "bin": {
    "migrate": "./cli.js"
  },
  "scripts": {
    "migrate:up": "node cli.js up --verbose",
    "migrate:down": "node cli.js down --verbose",
    "migrate:status": "node cli.js status",
    "migrate:validate": "node cli.js validate",
    "migrate:create": "node cli.js create",
    "migrate:init": "node cli.js init",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "dynamodb",
    "migration",
    "database",
    "vaidyalink"
  ],
  "author": "VaidyaLink Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/lib-dynamodb": "^3.450.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "framework/**/*.js",
      "utils/**/*.js",
      "!**/*.test.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
