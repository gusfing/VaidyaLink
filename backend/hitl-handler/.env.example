# =============================================================================
# HITL Handler Lambda Environment Configuration
# =============================================================================
# This Lambda manages the Human-in-the-Loop verification workflow for
# low-confidence document extractions.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# AWS Region
AWS_REGION=ap-south-1

# AWS Account ID
AWS_ACCOUNT_ID=123456789012

# -----------------------------------------------------------------------------
# DynamoDB Configuration
# -----------------------------------------------------------------------------
# DynamoDB table for scan job metadata
SCANJOBS_TABLE=vaidyalink-scanjobs-dev

# -----------------------------------------------------------------------------
# S3 Configuration
# -----------------------------------------------------------------------------
# S3 bucket for document storage
DOCUMENTS_BUCKET=vaidyalink-documents-dev-123456789012

# -----------------------------------------------------------------------------
# SQS Configuration
# -----------------------------------------------------------------------------
# SQS queue URL for HITL jobs (automatically set by infrastructure)
HITL_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/vaidyalink-hitl-dev

# -----------------------------------------------------------------------------
# Lambda Integration
# -----------------------------------------------------------------------------
# ARN of FHIR Transformer Lambda
FHIR_TRANSFORMER_LAMBDA_ARN=arn:aws:lambda:ap-south-1:123456789012:function:vaidyalink-fhir-transformer-dev

# Enable async invocation of FHIR transformer
ENABLE_ASYNC_FHIR_TRANSFORM=true

# -----------------------------------------------------------------------------
# Verification Configuration
# -----------------------------------------------------------------------------
# Maximum verification time in minutes
MAX_VERIFICATION_TIME=15

# Enable automatic assignment to verifiers
ENABLE_AUTO_ASSIGNMENT=false

# Verifier assignment strategy (round_robin, least_busy, priority)
ASSIGNMENT_STRATEGY=round_robin

# -----------------------------------------------------------------------------
# Monitoring and Logging
# -----------------------------------------------------------------------------
# CloudWatch log group
LOG_GROUP=/aws/lambda/vaidyalink-hitl-handler-dev

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable X-Ray tracing
ENABLE_XRAY_TRACING=true

# Enable detailed metrics
ENABLE_DETAILED_METRICS=true

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# SNS topic ARN for HITL notifications
HITL_NOTIFICATION_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:vaidyalink-hitl-notifications-dev

# Enable email notifications for new HITL jobs
ENABLE_EMAIL_NOTIFICATIONS=false

# Enable WebSocket notifications
ENABLE_WEBSOCKET_NOTIFICATIONS=true

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# KMS key ID for encrypting verification data
KMS_KEY_ID=

# Enable encryption for verification data at rest
ENABLE_ENCRYPTION=true

# Require MFA for verification submission
REQUIRE_MFA_FOR_VERIFICATION=false
