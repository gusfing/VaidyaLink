# =============================================================================
# Clinical Summarizer Lambda Environment Configuration
# =============================================================================
# This Lambda generates 30-second clinical summaries from patient FHIR records
# using Amazon Bedrock with Claude 3.5 Sonnet.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# AWS Region
AWS_REGION=ap-south-1

# AWS Account ID
AWS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Amazon Bedrock Configuration
# -----------------------------------------------------------------------------
# Bedrock model ID for clinical summarization
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock region
BEDROCK_REGION=us-east-1

# Maximum tokens for summary generation
BEDROCK_MAX_TOKENS=1024

# Temperature for Bedrock model (lower = more deterministic)
BEDROCK_TEMPERATURE=0.0

# Top-p sampling parameter
BEDROCK_TOP_P=0.9

# -----------------------------------------------------------------------------
# AWS HealthLake Configuration
# -----------------------------------------------------------------------------
# HealthLake datastore ID
HEALTHLAKE_DATASTORE_ID=

# HealthLake datastore endpoint
HEALTHLAKE_ENDPOINT=https://healthlake.ap-south-1.amazonaws.com

# HealthLake API version
HEALTHLAKE_API_VERSION=R4

# --------------------------------------
ummary length in words
MAX_SUMMARY_WORDS=200

# Maximum number of recent encounters to include
MAX_RECENT_ENCOUNTERS=10

# Maximum number of medications to highlight
MAX_MEDICATIONS=15

# Minimum confidence score for including facts (0.0 - 1.0)
MIN_FACT_CONFIDENCE=0.70

# Enable chronological ordering of events
ENABLE_CHRONOLOGICAL_ORDER=true

# Enable highlighting of critical information
ENABLE_CRITICAL_HIGHLIGHTS=true

# -----------------------------------------------------------------------------
# Clinical Data Configuration
# -----------------------------------------------------------------------------
# FHIR resource types to include in summary (comma-separated)
FHIR_RESOURCE_TYPES=Patient,Encounter,Condition,MedicationStatement,Observation,AllergyIntolerance,Procedure,DiagnosticReport

# Maximum age of records to include (in days, 0 = all records)
MAX_RECORD_AGE_DAYS=730

# Enable inclusion of lab results
INCLUDE_LAB_RESULTS=true

# Enable inclusion of vital signs
INCLUDE_VITAL_SIGNS=true

# Enable inclusion of diagnostic reports
INCLUDE_DIAGNOSTIC_REPORTS=true

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Enable caching of generated summaries
ENABLE_SUMMARY_CACHE=true

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600

# Invalidate cache on new records
INVALIDATE_ON_NEW_RECORDS=true

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------
# Maximum processing time in seconds
MAX_PROCESSING_TIME=30

# Enable parallel FHIR resource fetching
ENABLE_PARALLEL_FETCH=true

# Maximum concurrent FHIR queries
MAX_CONCURRENT_QUERIES=5

# -----------------------------------------------------------------------------
# Medical Terminology Configuration
# -----------------------------------------------------------------------------
# Enable medical term disambiguation
ENABLE_TERM_DISAMBIGUATION=true

# Enable flagging of ambiguous terms
ENABLE_AMBIGUITY_FLAGGING=true

# Medical terminology systems to use (comma-separated)
TERMINOLOGY_SYSTEMS=SNOMED-CT,ICD-10,LOINC,RxNorm

# -----------------------------------------------------------------------------
# Output Configuration
# -----------------------------------------------------------------------------
# Output format (json, markdown, html)
DEFAULT_OUTPUT_FORMAT=json

# Enable confidence scores in output
INCLUDE_CONFIDENCE_SCORES=true

# Enable source references in output
INCLUDE_SOURCE_REFERENCES=true

# Enable medical term explanations
INCLUDE_TERM_EXPLANATIONS=true

# -----------------------------------------------------------------------------
# Monitoring and Logging
# -----------------------------------------------------------------------------
# CloudWatch log group
LOG_GROUP=/aws/lambda/vaidyalink-clinical-summarizer-prod

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable X-Ray tracing
ENABLE_XRAY_TRACING=true

# Enable detailed metrics
ENABLE_DETAILED_METRICS=true

# Enable performance profiling
ENABLE_PROFILING=false

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# KMS key ID for encrypting cached summaries
KMS_KEY_ID=

# Enable encryption for cached data
ENABLE_ENCRYPTION=true
