# =============================================================================
# Document Processing Lambda Environment Configuration
# =============================================================================
# This Lambda handles OCR extraction and clinical data structuring from
# medical document images using PaddleOCR and Amazon Bedrock.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# AWS Region
AWS_REGION=ap-so
--------------------------------------------------------------------------
# Amazon Bedrock Configuration
# -----------------------------------------------------------------------------
# Bedrock model ID for clinical data structuring
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock region (if different from AWS_REGION)
BEDROCK_REGION=us-east-1

# Maximum tokens for Bedrock responses
BEDROCK_MAX_TOKENS=4096

# Temperature for Bedrock model (0.0 - 1.0)
BEDROCK_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# DynamoDB Configuration
# -----------------------------------------------------------------------------
# DynamoDB table for scan job metadata
DYNAMODB_SCAN_JOBS_TABLE=vaidyalink-scan-jobs-prod

# DynamoDB table for patient records
DYNAMODB_PATIENTS_TABLE=vaidyalink-patients-prod

# -----------------------------------------------------------------------------
# Processing Configuration
# -----------------------------------------------------------------------------
# Minimum confidence threshold for auto-processing (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.80

# Confidence threshold for critical fields (patient name, medications)
CRITICAL_FIELD_THRESHOLD=0.85

# Maximum processing time in seconds
MAX_PROCESSING_TIME=30

# Enable parallel processing for multi-page documents
ENABLE_PARALLEL_PROCESSING=true

# -----------------------------------------------------------------------------
# HITL (Human-in-the-Loop) Configuration
# -----------------------------------------------------------------------------
# SQS queue URL for HITL verification jobs
HITL_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/vaidyalink-hitl-queue-prod

# Enable automatic routing to HITL for low confidence
ENABLE_HITL_ROUTING=true

# -----------------------------------------------------------------------------
# Lambda Integration
# -----------------------------------------------------------------------------
# ARN of FHIR Transformer Lambda for downstream processing
FHIR_TRANSFORMER_LAMBDA_ARN=arn:aws:lambda:ap-south-1:ACCOUNT_ID:function:vaidyalink-fhir-transformer-prod

# Enable async invocation of FHIR transformer
ENABLE_ASYNC_FHIR_TRANSFORM=true

# -----------------------------------------------------------------------------
# OCR Configuration
# -----------------------------------------------------------------------------
# PaddleOCR model language support (comma-separated)
PADDLEOCR_LANGUAGES=en,hi,te,ta,mr,gu,kn,ml,pa,bn,or,as

# OCR detection model path (optional, uses default if not set)
# PADDLEOCR_DET_MODEL_PATH=/opt/models/det_model

# OCR recognition model path (optional, uses default if not set)
# PADDLEOCR_REC_MODEL_PATH=/opt/models/rec_model

# Enable GPU acceleration (if available)
PADDLEOCR_USE_GPU=false

# -----------------------------------------------------------------------------
# Monitoring and Logging
# -----------------------------------------------------------------------------
# CloudWatch log group
LOG_GROUP=/aws/lambda/vaidyalink-document-processing-prod

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable X-Ray tracing
ENABLE_XRAY_TRACING=true

# Enable detailed metrics
ENABLE_DETAILED_METRICS=true

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# KMS key ID for encrypting sensitive data
KMS_KEY_ID=

# Enable encryption for extracted data at rest
ENABLE_ENCRYPTION=true
