# =============================================================================
# Voice Processing Lambda Environment Configuration
# =============================================================================
# This Lambda handles multilingual voice-to-text transcription using Bhashini
# API and structures the transcribed medical history using Amazon Bedrock.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# AWS Region
AWS_REGION=ap-south-1

# AWS Account ID
AWS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# S3 Configuration
# -----------------------------------------------------------------------------
# S3 bucket for audio recordings
S3_AUDIO_BUCKET=vaidyalink-audio-prod

# S3 key prefix for raw audio files
S3_AUDIO_PREFIX=audio/

# S3 key prefix for transcriptions
S3_TRANSCRIPTION_PREFIX=transcriptions/

# -----------------------------------------------------------------------------
# Sarvam API Configuration
# -----------------------------------------------------------------------------
# Sarvam API endpoint for speech-to-text
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text

# Sarvam API key (get from https://www.sarvam.ai/)
SARVAM_API_KEY=sk_ld64ppk4_5n2aZnLmTWAbpZ40s0WY3OQf

# Request timeout for Sarvam API (in seconds)
SARVAM_TIMEOUT=30

# Maximum retries for Sarvam API calls
SARVAM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Amazon Bedrock Configuration
# -----------------------------------------------------------------------------
# Bedrock model ID for structuring transcribed text
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock region
BEDROCK_REGION=us-east-1

# Maximum tokens for Bedrock responses
BEDROCK_MAX_TOKENS=2048

# Temperature for Bedrock model
BEDROCK_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# DynamoDB Configuration
# -----------------------------------------------------------------------------
# DynamoDB table for voice job metadata
DYNAM
_AUDIO_DURATION=2

# Audio quality threshold (0-100)
AUDIO_QUALITY_THRESHOLD=60

# Noise level threshold in decibels
NOISE_THRESHOLD=60

# -----------------------------------------------------------------------------
# Transcription Configuration
# -----------------------------------------------------------------------------
# Minimum transcription confidence for auto-acceptance (0.0 - 1.0)
TRANSCRIPTION_CONFIDENCE_THRESHOLD=0.75

# Enable playback confirmation for low confidence transcriptions
ENABLE_PLAYBACK_CONFIRMATION=true

# Supported languages (ISO 639-1 codes, comma-separated)
SUPPORTED_LANGUAGES=en,hi,bn,te,mr,ta,gu,kn,ml,pa,or,as,ur,sa,ks,sd,ne,kok,mai,bodo,doi,mni

# Enable code-mixed language detection
ENABLE_CODE_MIXING=true

# -----------------------------------------------------------------------------
# Lambda Integration
# -----------------------------------------------------------------------------
# ARN of FHIR Transformer Lambda
FHIR_TRANSFORMER_LAMBDA_ARN=arn:aws:lambda:ap-south-1:ACCOUNT_ID:function:vaidyalink-fhir-transformer-prod

# Enable async invocation of FHIR transformer
ENABLE_ASYNC_FHIR_TRANSFORM=true

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------
# WebSocket API endpoint for real-time updates
WEBSOCKET_API_ENDPOINT=https://ws.vaidyalink.com

# WebSocket connection table
DYNAMODB_CONNECTIONS_TABLE=vaidyalink-ws-connections-prod

# -----------------------------------------------------------------------------
# Monitoring and Logging
# -----------------------------------------------------------------------------
# CloudWatch log group
LOG_GROUP=/aws/lambda/vaidyalink-voice-processing-prod

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable X-Ray tracing
ENABLE_XRAY_TRACING=true

# Enable detailed metrics
ENABLE_DETAILED_METRICS=true

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# KMS key ID for encrypting audio and transcriptions
KMS_KEY_ID=

# Enable encryption for audio files at rest
ENABLE_ENCRYPTION=true
